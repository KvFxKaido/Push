# Push sandbox image — Cloudflare Sandbox SDK 1.0 backend.
#
# SDK 1.0 no longer ships a base image with a server inside it: the Durable
# Object in app/src/worker/sandbox-do.ts drives this container directly through
# `ctx.container` (exec, files, backups). So this image is ours end to end. It
# reproduces what the 0.12 base (`cloudflare/sandbox:0.12.14-python`) provided,
# measured on 2026-10-24 with `docker run --entrypoint sh <image> -c …`:
#
#   0.12 base                   this image
#   Ubuntu 22.04.5              Debian 12 (bookworm)      ← deliberate change
#   Node v22.23.4, npm 10.9.9   Node v22.23.4 (same binary line)
#   Bun 1.4.4                   Bun 1.4.4
#   Python 3.11.14 + pip        Python 3.11.14 + pip
#   git curl wget jq zip unzip  same, plus the extras below
#   procps, ca-certificates     same
#   matplotlib numpy pandas     same (pip, unpinned like the base)
#   ipython; no gcc/make        same; still no compiler
#   root, HOME=/root            root, HOME=/root
#
# Debian instead of Ubuntu: the official Python and Node images publish exact
# version tags on bookworm, which keeps both pins reproducible without a third
# party PPA. glibc is 2.36 vs Ubuntu 22.04's 2.35 — newer, not older.
#
# NOTE ON NODE: stays on 22, not the repo-wide 24 floor. The sandbox runs the
# *user's* repo commands, and sandbox/app.py (Modal) mirrors this pin; the two
# backends must agree. Push's own `engines: node >=24` makes pnpm print a
# warn-only "Unsupported engine" when it installs Push itself here. Don't "fix"
# it by forcing Node 24 in here.
#
# Verify the versions instead of trusting this header:
#   docker run --rm --entrypoint sh <image> -c 'node -v; bun --version; python3 --version'

FROM docker.io/library/node:22.23.4-bookworm-slim AS node
FROM docker.io/library/golang:1.26-bookworm@sha256:23ce71337b726608afb1bc00986e630a05034a87a87ea1fc2cd1ae5cf33387eb AS artifactfs
RUN go install github.com/cloudflare/artifact-fs/cmd/artifact-fs@2b87a48691ef4ae82d391b7bbe4976c06c7fadf7
FROM docker.io/cloudflare/sandbox:1.0.3 AS shim

FROM docker.io/library/python:3.11.17-slim-bookworm

# Node from the official image (binary + npm/npx/corepack). Copied piecewise:
# the Python image also lives in /usr/local, so the whole tree can't be copied.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=artifactfs /go/bin/artifact-fs /usr/local/bin/artifact-fs
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack

# `sandbox-shim` backs the SDK's `Files` and `DirectoryBackup` helpers. Its tag
# must match @cloudflare/sandbox in app/package.json.
COPY --from=shim /usr/local/bin/sandbox-shim /usr/local/bin/sandbox-shim

ARG PUSH_SANDBOX_BUN_VERSION=1.4.4
ARG PUSH_SANDBOX_COREPACK_VERSION=0.35.0
# pnpm 10.x, NOT 11.x: keep this on the same major as the repo's `packageManager`
# (pnpm@10.34.5), because the pre-bake below installs Push's own node_modules with
# it and a corepack `packageManager` pin wins at runtime anyway. Move it when the
# repo's `packageManager` moves.
ARG PUSH_SANDBOX_PNPM_VERSION=10.34.5
ARG PUSH_SANDBOX_YARN_VERSION=4.17.0

# What the 0.12 base provided (git … ca-certificates), then the extras Push has
# always added: ripgrep is required by Push tool execution; file, git-lfs,
# rsync, sqlite3 and tree are small readiness conveniences. (No squashfs-tools:
# 0.12 SquashFS backups are refused at cutover, not converted.)
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      git \
      fuse3 \
      jq \
      procps \
      unzip \
      wget \
      zip \
      file \
      git-lfs \
      ripgrep \
      rsync \
      sqlite3 \
      tree \
 && git lfs install --system --skip-repo \
 && rm -rf /var/lib/apt/lists/*

# Python tooling: the 0.12 base's data libraries plus Push's lint/test pair.
RUN python3 -m pip install --no-cache-dir matplotlib numpy pandas ipython ruff pytest

# Default git identity — overridden per-session when a GitHub token is present.
RUN git config --global user.email 'sandbox@diff.app' \
 && git config --global user.name 'Push User'

# Bun, then Corepack shims with pnpm/yarn prefetched so pnpm/yarn repos don't
# spend their first sandbox command downloading the manager. A repo's
# packageManager pin still wins when one is present. Corepack must precede the
# pre-bake below: Push itself is a pnpm workspace.
RUN npm install -g bun@"${PUSH_SANDBOX_BUN_VERSION}" corepack@"${PUSH_SANDBOX_COREPACK_VERSION}" \
 && corepack enable \
 && COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack prepare pnpm@"${PUSH_SANDBOX_PNPM_VERSION}" --activate \
 && COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack prepare yarn@"${PUSH_SANDBOX_YARN_VERSION}" --activate

# Pre-bake node_modules into the image so fresh sandboxes skip the cold install
# that triggered the container stalls #374/#375 work around. Copying manifests +
# lockfile only (not the full tree) keeps these layers cacheable on lockfile
# hash. Layers are consumed at sandbox creation via `cp -al` from
# /opt/push-cache/* in routeCreate (worker-cf-sandbox.ts), gated on a byte-exact
# pnpm-lock.yaml match so only repos whose deps equal the baked ones get the
# cache. The workspace layout is reproduced exactly (app/, mcp/github-server/)
# because pnpm's per-package node_modules are relative symlinks into the root
# .pnpm virtual store. `HUSKY=0 CI=1` skips the husky install (no .git here);
# build scripts stay on so packages like esbuild fetch their native binaries.
# ONNXRUNTIME_NODE_INSTALL=skip stops onnxruntime-node's postinstall from
# downloading its CUDA/TensorRT providers (~330 MB, near-incompressible): the
# sandbox has no GPU, so they can never load, and they were the heaviest part of
# the layer Workers Builds times out pushing. The CPU runtime ships in the package.
WORKDIR /opt/push-cache
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY app/package.json ./app/
COPY mcp/github-server/package.json ./mcp/github-server/
# app/ depends on the in-repo Capacitor plugin via `file:../plugins/...`, so its
# source (not just a manifest) must be in the build context.
COPY plugins/capacitor-native-git ./plugins/capacitor-native-git
RUN HUSKY=0 CI=1 COREPACK_ENABLE_DOWNLOAD_PROMPT=0 ONNXRUNTIME_NODE_INSTALL=skip pnpm install --frozen-lockfile

COPY sandbox/bin/push-sandbox-doctor /usr/local/bin/push-sandbox-doctor
COPY sandbox/bin/push-artifacts-checkpoint sandbox/bin/push-artifactfs /usr/local/bin/
RUN chmod 0755 /usr/local/bin/push-artifacts-checkpoint /usr/local/bin/push-artifactfs
RUN chmod 0755 /usr/local/bin/push-sandbox-doctor

# No EXPOSE: SDK 1.0 reaches ports through `ctx.container.getTcpPort(port)`, and
# the migration guide says to drop EXPOSE lines. ENV lines don't reach `exec()`
# commands either; the facade passes its environment per call.
RUN mkdir -p /workspace
WORKDIR /workspace
CMD ["sleep", "infinity"]
