{
  "name": "my-app",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "node node_modules/typescript-go/lib/tsc.js --noEmit -p tsconfig.app.json && node node_modules/typescript-go/lib/tsc.js --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "biome format --write",
    "format:check": "biome format",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "cap:sync": "pnpm run build && cap sync",
    "android:setup": "node scripts/ensure-capacitor-android.mjs",
    "android:sync": "pnpm run build && pnpm run android:setup && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:icons": "npx --yes --package @capacitor/assets capacitor-assets generate --android",
    "electron:setup": "node scripts/ensure-capacitor-electron.mjs",
    "electron:sync": "pnpm run build && pnpm run electron:setup && cap sync @capawesome/capacitor-electron",
    "electron:open": "pnpm run electron:sync && cap open @capawesome/capacitor-electron",
    "electron:run": "pnpm run electron:sync && cap run @capawesome/capacitor-electron"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome/capacitor-electron": "^0.1.0",
    "@cloudflare/sandbox": "0.12.7",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@lezer/highlight": "^1.2.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-web": "^2.10.0",
    "capacitor-native-git": "file:../plugins/capacitor-native-git",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.33.0",
    "mermaid": "^11.17.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.3",
    "react-virtuoso": "^4.18.12",
    "recharts": "^3.10.1",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@cloudflare/workers-types": "^5.20260819.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "typescript-go": "npm:typescript@~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=24"
  }
}
