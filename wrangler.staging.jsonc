// STAGING Worker for rehearsing risky deploys (Sandbox SDK 1.0 first).
// Generated from wrangler.jsonc on 2026-10-24; keep it in step by hand.
// Differences from production: name push-staging; its own KV namespaces and
// R2 bucket (push-staging-snapshots); its own ratelimit namespaces; analytics
// dataset suffixed _staging; no cron triggers; no logpush; its own container
// name; max_instances 3. Deploy by hand only, never Workers Builds:
//   npx wrangler deploy -c wrangler.staging.jsonc
// Backups also need these Worker secrets (values never committed):
//   BACKUP_BUCKET_NAME, CLOUDFLARE_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
// See docs/decisions/Cloudflare Sandbox SDK 1.0 Migration.md (Phase 0).
{
  "name": "push-staging",
  "main": "./app/worker.ts",
  "build": {
    "command": "pnpm --filter my-app run build",
    "watch_dir": "./app/src"
  },
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./app/dist",
    "binding": "ASSETS"
  },
  "vars": {
    "PUSH_SANDBOX_PROVIDER": "cloudflare",
    "PUSH_RELAY_ENABLED": "1",
    "CF_AI_GATEWAY_CUSTOM_SLUGS": "ollama,sakana,fireworks,zen,zai,moonshot,huggingface",
    "CF_AI_GATEWAY_BYOK": "anthropic,deepseek,openai,google,openrouter,sakana,ollama,fireworks,zen,zai,moonshot,grok,huggingface"
  },
  "define": {
    "import.meta.env.DEV": "false",
    "import.meta.env.PROD": "true",
    "import.meta.env.MODE": "\"production\"",
    "import.meta.env.BASE_URL": "\"/\"",
    "import.meta.env.SSR": "true",
    "import.meta.env.VITE_ANTHROPIC_API_KEY": "\"\"",
    "import.meta.env.VITE_API_BASE_URL": "\"\"",
    "import.meta.env.VITE_CLOUDFLARE_GATEWAY_COMPAT_TOKEN": "\"\"",
    "import.meta.env.VITE_DEEPSEEK_API_KEY": "\"\"",
    "import.meta.env.VITE_FIREWORKS_API_KEY": "\"\"",
    "import.meta.env.VITE_GITHUB_APP_REDIRECT_URI": "\"\"",
    "import.meta.env.VITE_GITHUB_CLIENT_ID": "\"\"",
    "import.meta.env.VITE_GITHUB_OAUTH_PROXY": "\"\"",
    "import.meta.env.VITE_GITHUB_REDIRECT_URI": "\"\"",
    "import.meta.env.VITE_GITHUB_TOKEN": "\"\"",
    "import.meta.env.VITE_GITHUB_TOOL_BACKEND": "\"\"",
    "import.meta.env.VITE_GOOGLE_API_KEY": "\"\"",
    "import.meta.env.VITE_LOCAL_PC_MODE": "\"\"",
    "import.meta.env.VITE_NATIVE_WORKING_COPY": "\"\"",
    "import.meta.env.VITE_OLLAMA_API_KEY": "\"\"",
    "import.meta.env.VITE_OPENAI_API_KEY": "\"\"",
    "import.meta.env.VITE_OPENROUTER_API_KEY": "\"\"",
    "import.meta.env.VITE_OPENROUTER_TRANSPORT": "\"\"",
    "import.meta.env.VITE_RELAY_MODE": "\"\"",
    "import.meta.env.VITE_SAKANA_API_KEY": "\"\"",
    "import.meta.env.VITE_TAVILY_API_KEY": "\"\"",
    "import.meta.env.VITE_USE_STREAMDOWN": "\"\"",
    "import.meta.env.VITE_XAI_API_KEY": "\"\"",
    "import.meta.env.VITE_ZAI_API_KEY": "\"\"",
    "import.meta.env.VITE_KIMI_API_KEY": "\"\"",
    "import.meta.env.VITE_HUGGINGFACE_API_KEY": "\"\"",
    "import.meta.env.VITE_ZEN_API_KEY": "\"\""
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "9001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SNAPSHOT_INDEX",
      "id": "580ed61b973c48dea0ace2abec4edb3a"
    },
    {
      "binding": "SANDBOX_TOKENS",
      "id": "aa4bd99905e74901ba2bc7baff43a288"
    },
    {
      "binding": "ARTIFACTS",
      "id": "e99b0e009c3041749be4064d8d88a698"
    },
    {
      "binding": "CHAT_LIBRARY",
      "id": "585b42cdbc664a1dbab505a4cd128dcd"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "ZEN_KEY_STORE",
      "store_id": "13a7421a93df46e6bea9230445e057fd",
      "secret_name": "push-gate_zen_default"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "push-staging-snapshots"
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "push-staging-snapshots"
    }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "name": "push-staging-sandbox-do",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": { "dockerfile": "./Dockerfile.sandbox", "build_context": "." }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "Sandbox"
      },
      {
        "name": "CoderJob",
        "class_name": "CoderJob"
      },
      {
        "name": "RELAY_SESSIONS",
        "class_name": "RelaySessionDO"
      },
      {
        "name": "PrReviewJob",
        "class_name": "PrReviewJob"
      },
      {
        "name": "RUN_HOST",
        "class_name": "RunHost"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CoderJob"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["RelaySessionDO"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["PrReviewJob"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["RunHost"]
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "PROVIDER_STATS",
      "dataset": "push_provider_stats_staging"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "workers_dev": true
}
