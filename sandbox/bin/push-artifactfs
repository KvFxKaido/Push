#!/usr/bin/env bash
set -euo pipefail
export ARTIFACT_FS_ROOT=/var/lib/push-artifactfs
# ArtifactFS strips inline credentials and hydrates blobs with ambient Git
# credentials, so the read token lives in a store-helper file outside the
# workspace and its gitdir (checkpoints copy the gitdir, never this file).
CREDENTIALS=/var/lib/push-artifactfs-credentials
forget_credentials() {
  git config --global --name-only --get-regexp '^credential\..*artifacts\.cloudflare\.net.*\.helper$' 2>/dev/null |
    while read -r key; do git config --global --unset-all "$key" || true; done || true
  rm -f -- "$CREDENTIALS"
}
cleanup() {
  if mountpoint -q /workspace; then fusermount3 -u /workspace || return 1; fi
  if [ -f "$ARTIFACT_FS_ROOT/daemon.pid" ]; then
    kill "$(cat "$ARTIFACT_FS_ROOT/daemon.pid")" 2>/dev/null || true
  fi
  ! mountpoint -q /workspace || return 1
  forget_credentials
  rm -rf -- "$ARTIFACT_FS_ROOT"
}
if [ "${1:-}" = --cleanup ]; then cleanup; exit; fi
test -z "$(find /workspace -mindepth 1 -maxdepth 1 -print -quit)"
finish() {
  local status=$?
  trap - EXIT
  if [ "$status" -ne 0 ]; then cleanup || status=1; fi
  exit "$status"
}
trap finish EXIT
mkdir -p "$ARTIFACT_FS_ROOT"
remote="$PUSH_ARTIFACT_REMOTE"
case "$remote" in
https://*@*)
  rest="${remote#https://}"
  userinfo="${rest%%@*}"
  hostpath="${rest#*@}"
  host="${hostpath%%/*}"
  remote="https://$hostpath"
  (umask 077 && printf 'https://%s@%s\n' "$userinfo" "$host" >"$CREDENTIALS")
  git config --global "credential.https://$host.helper" "store --file=$CREDENTIALS"
  ;;
esac
timeout -k 5 60 artifact-fs add-repo --name workspace --remote "$remote" \
  --ref "refs/heads/$1" --depth 1 --refresh never --mount-root / >/dev/null 2>&1
nohup artifact-fs daemon --root / >"$ARTIFACT_FS_ROOT/daemon.log" 2>&1 &
echo "$!" >"$ARTIFACT_FS_ROOT/daemon.pid"
for attempt in $(seq 1 100); do
  if mountpoint -q /workspace && git -C /workspace rev-parse HEAD >/dev/null 2>&1; then
    git -C /workspace remote rename origin push-artifacts
    git -C /workspace remote add origin "$2"
    # A fresh clone has origin/<branch> at HEAD; upstream tracking and diff
    # bases rely on it.
    git -C /workspace update-ref "refs/remotes/origin/$1" HEAD
    git -C /workspace config "branch.$1.remote" origin
    git -C /workspace config "branch.$1.merge" "refs/heads/$1"
    exit 0
  fi
  kill -0 "$(cat "$ARTIFACT_FS_ROOT/daemon.pid")"
  sleep 0.1
done
exit 1
